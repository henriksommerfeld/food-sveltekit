{
  "name": "food-sveltekit",
  "version": "1.0.0",
  "private": false,
  "scripts": {
    "copy-images": "cp -rf ./static/uploads ./src/",
    "shrink-images": "node scripts/shrink-images.js",
    "dev": "npm run copy-images && vite dev",
    "build": "npm run copy-images && svelte-kit sync && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:once": "vitest --run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "deps": "pnpm ls --depth Infinity --parseable | wc -l",
    "docker:build": "docker build -t food-sveltekit .",
    "docker:run": "docker run food-sveltekit",
    "docker:clean:build": "docker build -t clean-images -f scripts/clean-images.dockerfile .",
    "docker:clean:run": "docker run -it -v ${PWD}/static/:/app/content clean-images"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sindresorhus/slugify": "4.0.1",
    "@sveltejs/adapter-auto": "8.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "mdsvex": "0.12.8",
    "minisearch": "7.2.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "sharp": "0.35.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-imagetools": "12.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "type": "module"
}
